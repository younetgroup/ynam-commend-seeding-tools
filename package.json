{
  "name": "yng-sheet-utilities",
  "version": "1.0.0",
  "description": "CLI tool for verifying Facebook comments via Google Sheets",
  "main": "dist/electron/electron/main.js",
  "type": "module",
  "bin": {
    "yng-tools": "./dist/index.js"
  },
  "scripts": {
    "start": "NODE_OPTIONS='--no-deprecation' tsx src/index.ts",
    "build": "tsc",
    "build:electron": "tsc --project tsconfig.electron.json && cp -r src/renderer dist/ && cp -r src/credentials dist/ && cp docs/YNG-logo-STool.png dist/renderer/ && cp docs/younet-logo.png dist/renderer/",
    "test": "vitest",
    "lint": "tsc --noEmit",
    "electron:dev": "npm run build:electron && electron .",
    "electron:start": "electron .",
    "electron:build": "npm run build:electron && electron-builder",
    "electron:build:mac": "npm run build:electron && electron-builder --mac",
    "electron:build:win": "npm run build:electron && electron-builder --win --x64"
  },
  "keywords": [
    "facebook",
    "verification",
    "automation",
    "cli"
  ],
  "author": "YNAM",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "build": {
    "appId": "com.younet.yng-sheet-utilities",
    "productName": "YNG STool",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/electron/**/*",
      "dist/renderer/**/*",
      "dist/commands/**/*",
      "dist/services/**/*",
      "dist/utils/**/*",
      "dist/types/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "dist/credentials",
        "to": "credentials"
      }
    ],
    "mac": {
      "icon": "docs/YNG-logo-STool.png",
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "docs/YNG-logo-STool.png",
      "target": [
        "nsis",
        "zip"
      ]
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.0",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "googleapis": "^130.0.0",
    "inquirer": "^9.2.0",
    "playwright": "^1.40.0",
    "tesseract.js": "^5.0.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.0",
    "@types/inquirer": "^9.0.0",
    "@types/node": "^20.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}