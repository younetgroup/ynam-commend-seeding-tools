# Gemini API Key for AI vision and content generation
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model for content generation and validation
# Options: gemini-3-flash-preview (faster, recommended), gemini-3-pro-preview (more capable), gemini-flash-latest (2.5 now), gemini-2.0-flash
# Default: gemini-3-flash-preview
GEMINI_DEFAULT_MODEL=gemini-3-flash-preview

# Path to Google Cloud Service Account JSON file
# Download from: Google Cloud Console > IAM & Admin > Service Accounts
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json
